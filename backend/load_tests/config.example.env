# Locust Load Test Configuration Example
# Copy to a local env file (do NOT commit real credentials or secrets).

# Target API base URL (local simulated server by default)
LOAD_TEST_HOST=http://127.0.0.1:8000

# Dedicated load-test user credentials (auto-registered if missing on local server)
LOAD_TEST_DISPATCHER_USER=lt_dispatcher
LOAD_TEST_DISPATCHER_PASS=lt_disp_pass_2026
LOAD_TEST_OPERATOR_USER=lt_operator
LOAD_TEST_OPERATOR_PASS=lt_oper_pass_2026

# Opt-in flag for write/mutation tasks (false = read-only safe mode by default)
# When true, only isolated "[LOAD_TEST]" tagged incidents are created/reviewed.
# Shared demo ambulances, hospitals, and beds are NEVER mutated.
LOAD_TEST_ENABLE_MUTATIONS=false
