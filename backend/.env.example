# Local Backend Environment Configuration (Example Template)
# Copy this file to backend/.env and fill in your real Gmail App Password locally.
# NEVER commit backend/.env or real credentials to Git.

OTP_DELIVERY_MODE=gmail
LOCAL_OTP_CONSOLE=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tom.axeron@gmail.com
SMTP_PASSWORD=your-gmail-app-password
OTP_EMAIL_FROM=tom.axeron@gmail.com
OTP_EMAIL_TO=tom.axeron@gmail.com

# Optional HMAC token signing secret (auto-generated per local run if omitted)
# AUTH_TOKEN_SECRET=replace-with-random-64-hex-string
